GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_HOST=your-index-host.pinecone.io
DB_URL=jdbc:postgresql://localhost:5432/GitHub%20Repo%20Analyzer%20Database
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
CHUNK_SIZE=40
CHUNK_OVERLAP=10
MAX_FILE_BYTES=500000
MAX_REPOSITORY_FILES=5000
MAX_REPOSITORY_SOURCE_BYTES=52428800
MAX_REPOSITORY_CHUNKS=5000
INDEX_REQUESTS_PER_HOUR=3
QUERIES_PER_MINUTE=20
FRONTEND_ORIGIN=http://localhost:5173
